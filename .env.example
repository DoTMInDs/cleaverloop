# ==============================================================================
# CleaverLoop AI — Environment Configuration Template (.env.example)
# Copy this file to .env and provide your production credentials.
# ==============================================================================

# Core Django Configuration
SECRET_KEY=django-insecure-change-this-to-a-cryptographically-random-string-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.cleaverloop.ai

# Database Configuration (PostgreSQL in production)
# DATABASE_URL=postgres://user:password@localhost:5432/cleaverloop
DATABASE_URL=sqlite:///db.sqlite3

# Cache & Celery Asynchronous Task Broker
REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Payment Processor (Paystack / Mobile Money)
PAYMENT_PROVIDER=paystack
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_CURRENCY=GHS
USD_TO_GHS_RATE=auto

# Storage Backend ('local' for local disk or 's3' for AWS S3 / Cloudflare R2)
STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=
AWS_QUERYSTRING_AUTH=False

# Generative AI Providers & API Keys
GOOGLE_AI_API_KEY=AIzaSyYourGoogleAIStudioKeyHere
FAL_KEY=your_fal_ai_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
KLING_API_KEY=your_kling_api_key_here
MINIMAX_API_KEY=your_minimax_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Provider Configuration
MOCK_PROVIDERS_ENABLED=False
DEFAULT_STARTER_CREDITS=500
